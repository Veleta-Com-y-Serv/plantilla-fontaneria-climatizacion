---
// Preguntas frecuentes: la cabeza a la izquierda (fija al bajar en escritorio) y las preguntas a la derecha como filas
// <details> con filete, sin JavaScript; el signo pasa de + a − al abrir. Campos: `preguntas[]` (pregunta, respuesta).
// Sin preguntas no se pinta. También sirve de diseño para apartados nuevos (`tipo: preguntas`).
import { seccion } from '../../data/site';
import Seccion from '../ui/Seccion.astro';
import Titular from '../ui/Titular.astro';
interface Props { id: string }
const s = seccion(Astro.props.id);
const preguntas = s ? s.preguntas : [];
---

{
  s && preguntas.length > 0 && (
    <Seccion id={Astro.props.id} banda="clara">
      <div class="faq-rejilla">
        <Titular antetitulo={s.antetitulo} titulo={s.titulo} texto={s.texto} />
        <div class="faq-lista">
          {preguntas.map((p) => (
            <details class="faq">
              <summary>
                <span>{p.pregunta}</span>
                <span class="faq-signo" aria-hidden="true" />
              </summary>
              {p.respuesta && <p class="faq-respuesta">{p.respuesta}</p>}
            </details>
          ))}
        </div>
      </div>
    </Seccion>
  )
}

<style>
  .faq-rejilla { display: grid; gap: 2.5rem; }
  .faq-lista { border-top: 1px solid var(--filete-2); }
  .faq { border-bottom: 1px solid var(--filete-2); }
  .faq summary { list-style: none; cursor: pointer; display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; min-height: 3.5rem; padding: 1.15rem 0; font-family: var(--fuente-titulos); font-weight: 500; font-size: clamp(1.1rem, 1rem + .4vw, 1.3rem); line-height: 1.3; color: var(--tinta); }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary:hover { color: var(--acento-legible); }
  .faq-signo { position: relative; width: 2rem; height: 2rem; flex-shrink: 0; border: 1px solid var(--filete-2); border-radius: var(--radio-campo); background: var(--tecla-cara); }
  .faq-signo::before, .faq-signo::after { content: ""; position: absolute; left: 50%; top: 50%; width: 12px; height: 1.5px; background: currentColor; transform: translate(-50%, -50%); }
  .faq-signo::after { transform: translate(-50%, -50%) rotate(90deg); transition: opacity var(--dur-corta) var(--salida); }
  .faq[open] .faq-signo::after { opacity: 0; }
  .faq-respuesta { padding: 0 3.5rem 1.5rem 0; color: var(--tinta-2); max-width: 64ch; }
  @media (min-width: 60rem) {
    .faq-rejilla { grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: 4rem; }
    .faq-rejilla > .titular { position: sticky; top: calc(var(--alto-cabecera) + 2rem); align-self: start; }
  }
</style>
